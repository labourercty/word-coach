{
  "name": "word-coach",
  "version": "1.0.0",
  "private": true,
  "description": "Word Coach: Capacitor Android app with Google AdMob",
  "scripts": {
    "build": "node -e \"const fs=require('fs');if(!fs.existsSync('www/index.html')){console.error('www/index.html is missing');process.exit(1)}console.log('www OK: '+fs.readdirSync('www').join(', '))\"",
    "sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor-community/admob": "^8.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
